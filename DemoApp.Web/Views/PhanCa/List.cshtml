@model IEnumerable<DemoApp.Entities.CaLam>

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center">Quản lý ca làm</h2>

<table class="table table-striped table-hover mt-5">
    <thead class="thead-dark">
        <tr>
            <th>Tên nhân viên</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Tên ca</th>
            <th class="text-center" width="30%">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td data-nhanvien="@item.MaNV">
                    @{
                        var maNV = item.MaNV;
                        var danhSachNhanVien = ViewBag.DanhSachNhanVien as List<DemoApp.Entities.NhanVien>;

                        if (danhSachNhanVien != null)
                        {
                            var nhanVien = danhSachNhanVien.FirstOrDefault(nv => nv.MaNV == maNV);

                            if (nhanVien != null)
                            {
                                @nhanVien.HoTen
                            }
                            else
                            {
                                @("Không có")
                            }
                        }
                        else
                        {
                            @("Danh sách phòng ban không có")
                        }
                    }
                </td>
                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(modelItem => item.MaLoai)</td>
                <td class="text-center">
                    @Html.ActionLink("Cập nhật", "Update", new { id = item.MaNV }, new { @class = "btn btn-warning btn-sm text-light" }) |
                    
                    <button class="btn btn-danger btn-sm delete-button" data-toggle="modal" data-target="#deleteModal" data-delete-id="@item.MaNV">Xoá</button>
                </td>
            </tr>
                        }
    </tbody>
</table>
