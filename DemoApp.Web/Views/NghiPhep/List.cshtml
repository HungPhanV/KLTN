@model IEnumerable<DemoApp.Entities.NghiPhep>

@{
    ViewBag.Title = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center">Danh sách đơn nghỉ phép</h2>
<table class="table table-striped table-hover mt-5 text-center">
    <thead class="thead-dark">
        <tr>
            <th>Tên nhân viên</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Tổng số ngày</th>
            <th>Loại nghỉ phép</th>
            <th>Lý do bổ sung</th>
            <th>Trạng thái</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td data-nhanvien="@item.MaNV">
                    @{
                        var maNV = item.MaNV;
                        var danhSachNhanVien = ViewBag.DanhSachNhanVien as List<DemoApp.Entities.NhanVien>;

                        if (danhSachNhanVien != null)
                        {
                            var nhanVien = danhSachNhanVien.FirstOrDefault(nv => nv.MaNV == maNV);

                            if (nhanVien != null)
                            {
                                @nhanVien.HoTen
                            }
                            else
                            {
                                @("Không có")
                            }
                        }
                        else
                        {
                            @("Danh sách phòng ban không có")
                        }
                    }
                </td>
                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td>@((item.NgayKetThuc - item.NgayBatDau).Days + 1) ngày</td>
                <td data-phongban="@item.MaLoaiNghiPhep">
                    @{
                        var maLoaiNP = item.MaLoaiNghiPhep;
                        var danhSachLoaiNghiPhep = ViewBag.DanhSachLoaiNghiPhep as List<DemoApp.Entities.LoaiNghiPhep>;

                        if (danhSachLoaiNghiPhep != null)
                        {
                            var loaiNghiPhep = danhSachLoaiNghiPhep.FirstOrDefault(lnp => lnp.MaLoaiNghiPhep == maLoaiNP);

                            if (loaiNghiPhep != null)
                            {
                                @loaiNghiPhep.TenLoai
                            }
                        }
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.LyDoBoSung)</td>
                <td>@Html.DisplayFor(modelItem => item.TrangThai)</td>
                <td class="text-center">
                    @if (item.TrangThai == "Đang chờ")
                    {
                        <div class="btn-group" role="group">
                            <a href="#" class="btn btn-success btn-sm text-light" data-id="@item.ID">Phê duyệt</a>
                            <a href="#" class="btn btn-danger btn-sm text-light" data-id="@item.ID">Huỷ bỏ</a>
                        </div>
                    }
                </td>
            </tr>
                        }
    </tbody>
</table>