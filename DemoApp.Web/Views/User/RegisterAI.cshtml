@{
    ViewBag.Title = "ThongKe";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Thêm link Font Awesome CDN nếu chưa có -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">

<style>
    /* Đặt chiều cao của container và căn giữa theo chiều dọc */
    .container-custom {
        height: 80vh; /* Chiều cao toàn màn hình */
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f8f9fa; /* Màu nền của container */
    }
</style>

<div class="container container-custom">
    <div class="row">
        <div class="col text-center">
            <button id="saveButton" class="btn btn-info mx-2">
                <i class="fas fa-user-plus"></i> Đăng ký khuôn mặt
            </button>
            <button id="cancelButton" class="btn btn-danger mx-2">
                <i class="fas fa-user-slash"></i> Huỷ đăng ký khuôn mặt
            </button>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // Khi nhấn nút "Đăng ký khuôn mặt"
        $("#saveButton").click(function () {
            // Gọi API để lấy thông tin người dùng đăng nhập
            $.ajax({
                url: "/User/GetCurrentUserInfo",  // Thay thế 'ControllerName' bằng tên controller
                method: "GET",
                success: function (response) {
                    if (response.status) {
                        const userName = response.userName;
                        const userId = response.userId;
                        // Gọi API /add với username và userId đã lấy
                        $.ajax({
                            url: "http://127.0.0.1:5000/add",
                            method: "POST",
                            contentType: "application/json",
                            data: JSON.stringify({
                                userName: userName,
                                userId: userId
                            }),
                            success: function (addResponse) {
                                if (addResponse.status === 'ok') {
                                    alert('Đăng ký khuôn mặt thành công!');
                                } else {
                                    alert(addResponse.message);
                                }
                            },
                            error: function (xhr) {
                                alert('Lỗi: ' + (xhr.responseJSON ? xhr.responseJSON.message : 'Có lỗi xảy ra!'));
                            }
                        });
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert('Không thể lấy thông tin người dùng.');
                }
            });
        });

        $(document).ready(function () {
            // Khi nhấn nút "Huỷ đăng ký khuôn mặt"
            $("#cancelButton").click(function () {
                // Gọi API để lấy thông tin người dùng đăng nhập
                $.ajax({
                    url: "/User/GetCurrentUserInfo",  // Thay thế 'ControllerName' bằng tên controller
                    method: "GET",
                    success: function (response) {
                        if (response.status) {
                            const userName = response.userName;
                            const userId = response.userId;

                            // Hiển thị thông báo xác nhận bằng SweetAlert2
                            Swal.fire({
                                title: 'Bạn có chắc chắn muốn hủy đăng ký khuôn mặt?',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#3085d6',
                                cancelButtonColor: '#d33',
                                confirmButtonText: 'Hủy đăng ký!',
                                cancelButtonText: 'Không'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // Gọi API /delete_face với username và userId đã lấy
                                    $.ajax({
                                        url: "http://127.0.0.1:5000/delete_face",
                                        method: "POST",
                                        contentType: "application/json",
                                        data: JSON.stringify({
                                            user_id: userId,
                                            username: userName
                                        }),
                                        success: function (deleteResponse) {
                                            if (deleteResponse.status === 'success') {
                                                Swal.fire({
                                                    icon: 'success',
                                                    title: 'Thành công',
                                                    text: 'Huỷ đăng ký khuôn mặt thành công!',
                                                    confirmButtonText: 'OK'
                                                }).then(() => {
                                                    // Reload lại trang sau khi hoàn thành
                                                    location.reload();
                                                });
                                            } else {
                                                Swal.fire({
                                                    icon: 'error',
                                                    title: 'Lỗi',
                                                    text: deleteResponse.message,
                                                    confirmButtonText: 'OK'
                                                });
                                            }
                                        },
                                        error: function (xhr) {
                                            Swal.fire({
                                                icon: 'error',
                                                title: 'Lỗi',
                                                text: xhr.responseJSON ? xhr.responseJSON.message : 'Có lỗi xảy ra!',
                                                confirmButtonText: 'OK'
                                            });
                                        }
                                    });
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: response.message,
                                confirmButtonText: 'OK'
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể lấy thông tin người dùng.',
                            confirmButtonText: 'OK'
                        });
                    }
                });
            });
        });
    });

</script>