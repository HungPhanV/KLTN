@model IEnumerable<DemoApp.Entities.TaiKhoan>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center">Quản lý tài khoản</h2>
<button type="button" class="btn btn-success mt-5" data-toggle="modal" data-target="#createModal">
    Tạo tài khoản
</button>
<table class="table table-striped table-hover mt-4">
    <thead class="thead-dark">
        <tr>
            <th>Tên nhân viên</th>
            <th>Tên tài khoản</th>
            <th>Mật khẩu</th>
            <th>Vai trò</th>
            <th class="text-center" width="20%">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @{
                        var maNV = item.MaNV;
                        var danhSachNhanVien = ViewBag.DanhSachNhanVien as List<DemoApp.Entities.NhanVien>;

                        if (danhSachNhanVien != null)
                        {
                            var nhanVien = danhSachNhanVien.FirstOrDefault(nv => nv.MaNV == maNV);

                            if (nhanVien != null)
                            {
                                @nhanVien.HoTen
                            }
                            else
                            {
                                @("Không có")
                            }
                        }
                        else
                        {
                            @("Danh sách phòng ban không có")
                        }
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                <td>******</td>
                <td>@Html.DisplayFor(modelItem => item.Role)</td>
                <td class="text-center">
                    <div class="">
                        <button class="btn btn-warning btn-sm text-light" id="editTaiKhoanButton" data-toggle="modal" data-target="#editTaiKhoanModal"> Cập nhật</button>
                        <button class="btn btn-danger btn-sm" data-toggle="modal" data-target="#deleteModal" data-delete-id="@item.Username" data-delete-type="parent"> Xoá</button>
                    </div>
                </td>
            </tr>
                        }
    </tbody>
</table>

<!-- Edit Modal -->
<div class="modal fade" id="editTaiKhoanModal" tabindex="-1" role="dialog" aria-labelledby="editTaiKhoanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTaiKhoanModalLabel">Sửa thông tin tài khoản</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editTaiKhoanForm">
                    <div class="form-group">
                        <label for="editPassword">Mật khẩu:</label>
                        <input type="text" class="form-control" id="editPassword">
                    </div>
                    <div class="form-group">
                        <label for="editRole">Vai trò:</label>
                        <select class="form-control" id="editRole" name="role">
                            <option value="user">User</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                    <input type="hidden" id="editMaNV">
                    <input type="hidden" id="editUsername">
                    <button type="submit" class="btn btn-success float-right">Lưu thay đổi</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xoá</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xoá tài khoản này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <form id="deleteForm" action="" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger" id="btn-delete-modal">Xoá</button>
                </form>
            </div>
        </div>
    </div>
</div>

