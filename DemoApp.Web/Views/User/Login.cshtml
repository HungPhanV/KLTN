@{
    Layout = null; // Không sử dụng layout
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>SB Admin 2 - Login</title>
    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">
    <!-- Custom styles for this template-->
    <link href="/css/sb-admin-2.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- CSS Files -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="assets/css/plugins.min.css">
    <link rel="stylesheet" href="assets/css/kaiadmin.min.css">
    <!-- CSS Just for demo purpose, don't include it in your project -->
    <link rel="stylesheet" href="assets/css/demo.css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <link rel="stylesheet" href="~/assets/css/kaiadmin.min.css" />
    <link rel="stylesheet" href="~/assets/css/plugins.min.css" />
    <link rel="stylesheet" href="~/assets/css/demo.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

</head>

<body data-background-color="dark">

    <div class="container mt-5">

        <!-- Outer Row -->
        <div class="row justify-content-center">


            <div class="col-lg-6 justify-content-center align-items-center">
                <div class="card o-hidden border-0 shadow-lg my-3">
                    <div class="card-body p-0">
                        <!-- Nested Row within Card Body -->
                        <div class="row">
                            <div class="col-lg-6 d-none d-lg-block bg-login-image">
                                <img src="~/img/614ded2f761c1c21130cec53.png" />
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 justify-content-center align-items-center">
                <div class="p-4">
                    <div class="text-center">
                        <h1 class="text-warning mb-4 mt-5" style="font-size:45px !important">Chào mừng bạn quay trở lại!</h1>
                    </div>
                    @using (Html.BeginForm("Login", "User", FormMethod.Post, new { @class = "user" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <input type="text" class="form-control form-control-user bg-light text-black-50" id="exampleInputEmail" name="userName" aria-describedby="emailHelp" placeholder="Tên đăng nhập..." style="font-size:15px">
                        </div>
                        <div class="form-group">
                            <input type="password" class="form-control form-control-user bg-light text-black-50" id="exampleInputPassword" name="password" placeholder="Mật khẩu..." style="font-size:15px">
                        </div>
                        <div class="form-group">
                            <div class="custom-control custom-checkbox small">
                                <input type="checkbox" class="custom-control-input" id="customCheck">
                                <label class="custom-control-label text-white" for="customCheck">Ghi nhớ tôi</label>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-warning d-block w-100 btn-user text-white" style="font-size:16px">Đăng nhập</button>
                        <div class="text-center mt-2">
                            <button type="button" class="btn text-white w-75 mx-auto" id="loginWithFace" style="font-size:15px">
                                <i class="fas fa-smile"></i> Đăng nhập bằng khuôn mặt
                            </button>
                        </div>
                        <hr>
                    }
                  

                    <a href="#!" class="text-white">Quên mật khẩu?</a>
                    <p class="mb-5 pb-lg-2 text-white">
                        Chưa có tài khoản? Liên hệ ngay
                    </p>
                    <a href="#!" class="text-muted">Terms of use.</a>
                    <a href="#!" class="text-muted">Privacy policy</a>
                </div>
            </div>



        </div>



    </div>
    <script>
    $(document).ready(function () {
        // Xử lý sự kiện khi submit form đăng nhập bình thường
        $("form.user").submit(function (event) {
            // Ngăn chặn gửi form mặc định
            event.preventDefault();

            // Lấy giá trị của các trường input
            var userName = $("#exampleInputEmail").val();
            var password = $("#exampleInputPassword").val();

            // Kiểm tra xem các trường có dữ liệu không
            if (userName === '' && password === '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Vui lòng nhập tên đăng nhập và mật khẩu!'
                });
            }
            else if (userName === '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Vui lòng nhập tên đăng nhập!'
                });
            }
            else if (password === '') {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Vui lòng nhập mật khẩu!'
                });
            }
            else {
                // Gửi form nếu dữ liệu hợp lệ
                $("form.user").unbind("submit").submit();
            }
        });

        // Kết nối với API start khi bấm nút đăng nhập bằng khuôn mặt
        $("#loginWithFace").click(function () {
            $.ajax({
                url: "http://127.0.0.1:5000/start", // API xác thực khuôn mặt
                method: "POST",
                contentType: "application/json",
                success: function (response) {
                    // Hiển thị phản hồi từ API nếu thành công
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: response.message
                    });

                    // Hiển thị chi tiết user nếu xác thực thành công
                    if (response.status) {
                        $("#startResponse").html(`
                    <p>Xác thực thành công: ${response.user.username} (ID: ${response.user.user_id})</p>
                `);

                        // Gọi API đăng nhập với id trả về từ API start
                        $.ajax({
                            url: "/User/FaceLogin", // Đường dẫn tới API đăng nhập ở backend
                            method: "POST",
                            data: { id: response.user.user_id }, // Truyền id lấy từ response
                            success: function (loginResponse) {
                                if (loginResponse.status) {
                                    // Hiển thị thông báo đăng nhập thành công
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Đăng nhập thành công',
                                        text: loginResponse.message,
                                        timer: 2000, // Thời gian hiển thị thông báo là 2 giây
                                        showConfirmButton: false // Không cần nút xác nhận
                                    });

                                    // Chuyển trang sau 2 giây
                                    setTimeout(function () {
                                        window.location.href = "/Home/ThongKe"; // Điều hướng tới trang sau khi đăng nhập
                                    }, 2000); // Trì hoãn 2 giây trước khi chuyển hướng
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Đăng nhập thất bại',
                                        text: loginResponse.message
                                    });
                                }
                            },
                            error: function (xhr) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi',
                                    text: xhr.responseJSON ? xhr.responseJSON.message : 'Có lỗi xảy ra khi gọi API đăng nhập!'
                                });
                            }
                        });
                    } else {
                        $("#startResponse").html(`<p>${response.message}</p>`);
                    }
                },
                error: function (xhr) {
                    // Xử lý khi có lỗi từ API start
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: xhr.responseJSON ? xhr.responseJSON.message : 'Không thể kết nối tới API!'
                    });
                }
            });
        });


    });
    </script>



</body>

</html>